SUSO_URL=https://survey.statsghana.gov.gh
SUSO_WORKSPACE=gaes
SUSO_USER=your_api_user
SUSO_PASSWORD=your_api_password
SUSO_QUESTIONNAIRE_VARIABLE=gaes_data
AUTH_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Automatic refresh: request a new Survey Solutions export when the latest is older than N minutes (0 = off)
GAES_AUTO_EXPORT_MINUTES=30
# Secret for the scheduled refresh endpoint /api/cron (Netlify runs it every 15 min automatically)
CRON_SECRET=change-me-to-another-long-random-string
# Optional on Vercel: enables persistent users.json in Vercel Blob
# BLOB_READ_WRITE_TOKEN=
